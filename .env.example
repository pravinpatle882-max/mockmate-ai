# Environment Variables for AI Interview System

# Google Gemini API Key (Leave empty to run in Demo Mode with built-in question repository & fallback evaluator)
GEMINI_API_KEY=

# Secret key for JWT auth token generation
SECRET_KEY=ai_interview_secret_key_super_secure_college_project_2026

# JWT Algorithm and Expiration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server settings
HOST=127.0.0.1
PORT=8000
